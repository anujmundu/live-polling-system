# MLOps Platform Environment Configuration
ENVIRONMENT=development
SERVICE_NAME=mlops-anomaly-detection
DEBUG=true

# Kafka Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=sensor.telemetry.raw
KAFKA_TOPIC_VALIDATED=sensor.telemetry.validated
KAFKA_TOPIC_QUARANTINE=sensor.telemetry.quarantine
KAFKA_CONSUMER_GROUP=mlops-anomaly-consumers

# Storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mlops_anomaly_db
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=telemetry-lakehouse

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=realtime-anomaly-detection
MLFLOW_MODEL_NAME=IndustrialAnomalyDetector

# Quality Gates
GATE_MIN_PRECISION=0.90
GATE_MIN_RECALL=0.88
GATE_MAX_FPR=0.025
GATE_MAX_P99_LATENCY_MS=15.0
GATE_MAX_MODEL_SIZE_MB=150.0
GATE_F1_IMPROVEMENT_THRESHOLD=0.015

# Drift Thresholds
DRIFT_PSI_THRESHOLD_WARNING=0.10
DRIFT_PSI_THRESHOLD_CRITICAL=0.25
DRIFT_KS_P_VALUE_THRESHOLD=0.01

# Inference API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
